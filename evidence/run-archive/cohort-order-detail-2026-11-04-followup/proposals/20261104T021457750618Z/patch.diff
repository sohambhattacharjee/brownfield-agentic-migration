+def order_detail(raw_id):
+    """Validate an ID and retrieve one order without changing persisted state."""
+    if not raw_id or not raw_id.isascii() or not raw_id.isdigit():
+        return 400, {"error": "invalid_order_id"}
+    normalized_id = raw_id.lstrip("0") or "0"
+    # SQLite integer primary keys cannot exceed the signed 64-bit range.
+    # Check before conversion to also handle arbitrarily long numeric IDs.
+    if len(normalized_id) > 19 or (
+        len(normalized_id) == 19 and normalized_id > "9223372036854775807"
+    ):
+        return 404, {"error": "order_not_found"}
+    db = connect()
+    try:
+        row = db.execute(
+            "SELECT id, customer, city, subtotal_cents, shipping_cents, total_cents FROM orders WHERE id = ?",
+            (int(normalized_id),),
+        ).fetchone()
+        if row is None:
+            return 404, {"error": "order_not_found"}
+        return 200, order_payload(db, row)
+    finally:
+        db.close()
 
 
