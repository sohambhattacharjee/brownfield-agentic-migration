+def get_order(order_id):
+    """Read one order using the same representation as the order list."""
+    db = connect()
+    try:
+        row = db.execute(
+            "SELECT id, customer, city, subtotal_cents, shipping_cents, total_cents, status "
+            "FROM orders WHERE id = ?", (order_id,)
+        ).fetchone()
+        if row is None:
+            return None
+        order = dict(row)
+        state = order.pop("status")
+        order["items"] = [dict(item) for item in db.execute(
+            "SELECT sku, qty, unit_price_cents FROM order_items WHERE order_id = ?", (order_id,)
+        ).fetchall()]
+        if state != "active":
+            order["status"] = state
+        return order
+    finally:
+        db.close()
+
