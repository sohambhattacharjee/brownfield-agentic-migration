+def cancel_order(order_id):
+    """Cancel and restore inventory in a single serialized write transaction."""
+    db = connect()
+    try:
+        db.execute("BEGIN IMMEDIATE")
+        order = db.execute("SELECT status FROM orders WHERE id = ?", (order_id,)).fetchone()
+        if order is None:
+            db.rollback()
+            return 404, {"error": "order_not_found"}
+        if order["status"] == "canceled":
+            db.rollback()
+            return 409, {"error": "already_canceled"}
+        items = db.execute(
+            "SELECT sku, qty FROM order_items WHERE order_id = ?", (order_id,)
+        ).fetchall()
+        for item in items:
+            db.execute(
+                "UPDATE products SET stock = stock + ? WHERE sku = ?",
+                (item["qty"], item["sku"]),
+            )
+        db.execute("UPDATE orders SET status = 'canceled' WHERE id = ?", (order_id,))
+        db.commit()
+        return 200, {"status": "canceled"}
+    except sqlite3.Error as exc:
+        db.rollback()
+        return 500, {"error": "persistence_error", "detail": str(exc)}
+    finally:
+        db.close()
